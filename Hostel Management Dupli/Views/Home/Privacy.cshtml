@{
    ViewData["Title"] = "About & Privacy Policy";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="app-card">
            <h2 class="fw-bold mb-3"><i class="bi bi-shield-check text-primary me-2"></i>About Sunshine Hostel Management</h2>
            <p class="text-secondary">
                The Sunshine Hostel Management System is built on ASP.NET Core 10 to streamline student accommodation, 
                room inventory, and operational administration for modern residential hostels.
            </p>

            <h5 class="fw-bold mt-4 mb-2">Our Commitment</h5>
            <p class="text-secondary">
                We maintain transparency, fair room allocations, and student safety. All submitted student data 
                is stored securely and used solely for hostel management purposes.
            </p>

            <h5 class="fw-bold mt-4 mb-2">Hostel Guidelines & Rules</h5>
            <ul class="text-secondary">
                <li>Hostel curfew time is 9:30 PM on weekdays and 10:00 PM on weekends.</li>
                <li>Visitors are permitted in the reception lounge only during visiting hours (4:00 PM - 7:00 PM).</li>
                <li>Rooms must be kept clean, and common property handled with care.</li>
                <li>Monthly hostel rents are payable within the first 5 days of each calendar month.</li>
            </ul>

            <h5 class="fw-bold mt-4 mb-2">Administration Contact</h5>
            <p class="text-secondary mb-0">
                Warden Office, Sunshine Hostel, VSNL Road, Kakkanad, Kochi, Kerala.<br />
                Phone: +91-9876543210 | Email: warden@sunshinehostel.com
            </p>
        </div>
    </div>
</div>
