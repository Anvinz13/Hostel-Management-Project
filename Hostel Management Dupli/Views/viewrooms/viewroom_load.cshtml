@model List<Hostel_Management_Dupli.Models.Addroommodel>
@{
    ViewData["Title"] = "Available Rooms";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="fw-bold"><i class="bi bi-grid text-primary me-2"></i>Available Rooms & Accommodation</h2>
        <p class="text-muted">Explore hostel room categories, monthly pricing, and request your preferred room.</p>
    </div>
    <div>
        <a asp-controller="Request" asp-action="MyRequests" class="btn btn-outline-primary">
            <i class="bi bi-card-checklist me-1"></i> Track My Requests
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="table-container">
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-door-closed"></i>
            </div>
            <h4>No Rooms Currently Available</h4>
            <p class="text-muted">Please check back soon or contact the warden office at +91-9876543210.</p>
        </div>
    </div>
}
else
{
    <!-- Room Cards Grid -->
    <div class="row g-4 mb-4">
        @foreach (var room in Model)
        {
            <div class="col-md-6 col-lg-3">
                <div class="room-card">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i> Available
                            </span>
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-person me-1"></i> @room.Occupied Beds Occupied
                            </span>
                        </div>
                        <h5 class="fw-bold text-dark mt-2 mb-1">@room.Roomtype</h5>
                        <p class="text-muted small mb-3">Fully furnished room with dedicated study table, wardrobe, and fan.</p>
                        
                        <div class="mb-4">
                            <span class="room-price">₹@room.Rent</span>
                            <span class="room-price-sub">/ month</span>
                        </div>

                        <div class="d-flex flex-column gap-2 mb-4 small text-secondary">
                            <div><i class="bi bi-wifi text-primary me-2"></i> High-Speed WiFi included</div>
                            <div><i class="bi bi-lightning text-warning me-2"></i> 24/7 Power Backup</div>
                            <div><i class="bi bi-shield-check text-success me-2"></i> Round-the-clock Security</div>
                        </div>
                    </div>

                    <a asp-controller="Request"
                       asp-action="RequestRoom"
                       asp-route-type="@room.Roomtype"
                       asp-route-rent="@room.Rent"
                       class="btn btn-primary w-100">
                        <i class="bi bi-send me-1"></i> Request This Room
                    </a>
                </div>
            </div>
        }
    </div>
}
