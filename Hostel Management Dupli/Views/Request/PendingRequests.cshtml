@model List<Hostel_Management_Dupli.Models.Requstcls>
@{
    ViewData["Title"] = "Pending Requests";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2 class="fw-bold"><i class="bi bi-inbox text-primary me-2"></i>Pending Room Requests</h2>
        <p class="text-muted">Review student room booking applications and approve or reject them.</p>
    </div>
    <div>
        <a asp-controller="Adminhome" asp-action="Adminhomeload" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>
</div>

<div class="table-container">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon text-success">
                <i class="bi bi-check2-circle"></i>
            </div>
            <h4>All Caught Up!</h4>
            <p class="text-muted">There are no pending room booking requests at the moment.</p>
            <a asp-controller="Adminhome" asp-action="Adminhomeload" class="btn btn-outline-primary">
                Return to Dashboard
            </a>
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Req #</th>
                    <th>Student ID</th>
                    <th>Requested Room</th>
                    <th>Monthly Rent</th>
                    <th>Status</th>
                    <th style="width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in Model)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border">#@req.RequestId</span></td>
                        <td>
                            <span class="fw-semibold"><i class="bi bi-person me-1 text-secondary"></i> Student #@req.User_id</span>
                        </td>
                        <td>
                            <span class="fw-bold text-dark">@req.RoomType</span>
                        </td>
                        <td>
                            <span class="text-primary fw-bold">₹@req.Rent</span>
                            <span class="text-muted small">/mo</span>
                        </td>
                        <td>
                            <span class="badge-status badge-pending">
                                <i class="bi bi-hourglass-split"></i> @req.Status
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Approve" asp-route-id="@req.RequestId" class="btn btn-sm btn-success">
                                    <i class="bi bi-check-lg"></i> Approve
                                </a>
                                <a asp-action="Reject" asp-route-id="@req.RequestId" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to reject this room request?');">
                                    <i class="bi bi-x-lg"></i> Reject
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
