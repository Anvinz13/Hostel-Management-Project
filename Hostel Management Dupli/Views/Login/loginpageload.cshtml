@model Hostel_Management_Dupli.Models.Logincls
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-4">
    <div class="col-md-5 col-lg-4">
        <div class="app-card shadow-lg border-0">
            <div class="text-center mb-4">
                <div class="stat-icon primary mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.75rem;">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="text-muted small">Sign in to Sunshine Hostel Portal</p>
            </div>

            <form asp-action="Login_Click" method="post" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="l1">
                        <i class="bi bi-person me-1"></i> Username
                    </label>
                    <input asp-for="Username" class="form-control" id="l1" placeholder="Enter your username" required autofocus />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0" for="l2">
                            <i class="bi bi-key me-1"></i> Password
                        </label>
                    </div>
                    <input asp-for="Password" class="form-control" id="l2" type="password" placeholder="Enter your password" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <div class="p-3 bg-light rounded-3 border mb-3">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-info-circle text-primary"></i>
                    <strong class="small text-secondary">Demo Credentials</strong>
                </div>
                <div class="small text-muted">
                    <div><strong>Admin:</strong> <code>admin</code> / <code>admin123</code></div>
                    <div><strong>Student:</strong> <code>student</code> / <code>user123</code></div>
                </div>
            </div>

            <div class="text-center small text-muted border-top pt-3">
                Don't have an account? <br />
                <a asp-controller="Userreg" asp-action="Userpageload" class="fw-semibold text-primary text-decoration-none">
                    Register as Student
                </a>
                <span class="mx-1">•</span>
                <a asp-controller="Adminreg" asp-action="Admin_pageload" class="text-secondary text-decoration-none">
                    Admin Signup
                </a>
            </div>
        </div>
    </div>
</div>
