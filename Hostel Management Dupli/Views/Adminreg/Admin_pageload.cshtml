@model Hostel_Management_Dupli.Models.Admincls
@{
    ViewData["Title"] = "Admin Registration";
}

<div class="row justify-content-center py-3">
    <div class="col-md-6 col-lg-5">
        <div class="app-card shadow-md">
            <div class="text-center mb-4">
                <div class="stat-icon warning mx-auto mb-2" style="width: 52px; height: 52px;">
                    <i class="bi bi-shield-lock-fill fs-3 text-dark"></i>
                </div>
                <h3 class="fw-bold mb-1">Admin Registration</h3>
                <p class="text-muted small">Register a new hostel administration account</p>
            </div>

            <form asp-action="adminclick" method="post" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="d1">Admin Full Name</label>
                    <input asp-for="Name" class="form-control" id="d1" placeholder="Administrator Name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="d2">Contact Phone</label>
                    <input asp-for="Phone" class="form-control" id="d2" placeholder="+91-9876543210" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="d3">Official Email</label>
                    <input asp-for="Email" type="email" class="form-control" id="d3" placeholder="admin@sunshinehostel.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="d4">Username</label>
                    <input asp-for="Username" class="form-control" id="d4" placeholder="Admin username" required />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="d5">Password</label>
                    <input asp-for="Password" type="password" class="form-control" id="d5" placeholder="Secure password" required />
                </div>

                <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2 mb-3">
                    <i class="bi bi-shield-check me-1"></i> Register Administrator
                </button>
            </form>

            <div class="text-center small text-muted border-top pt-3">
                Already have an admin account? <a asp-controller="Login" asp-action="loginpageload" class="fw-semibold text-primary text-decoration-none">Sign In</a>
            </div>
        </div>
    </div>
</div>
