@model Hostel_Management_Dupli.Models.Addroommodel
@{
    ViewData["Title"] = "Add Room Details";
}

<div class="row justify-content-center py-3">
    <div class="col-md-7 col-lg-6">
        <div class="app-card shadow-md">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0"><i class="bi bi-door-open text-primary me-2"></i>Add Room Details</h3>
                <a asp-controller="Adminhome" asp-action="Adminhomeload" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
            </div>
            <p class="text-muted small mb-4">Register a new room category and set rental pricing for Sunshine Hostel.</p>

            <form asp-action="AddRoomClick" asp-controller="Addroom" method="post">
                <div class="mb-3">
                    <label class="form-label" for="Roomtype">
                        <i class="bi bi-tag me-1"></i> Sharing Type / Category
                    </label>
                    <select name="Roomtype" id="Roomtype" class="form-select" required>
                        <option value="">-- Select Room Category --</option>
                        <option value="Single Room (AC)">Single Room (AC)</option>
                        <option value="Single Room (Non-AC)">Single Room (Non-AC)</option>
                        <option value="2-Sharing (AC)">2-Sharing (AC)</option>
                        <option value="2-Sharing (Non-AC)">2-Sharing (Non-AC)</option>
                        <option value="3-Sharing (Non-AC)">3-Sharing (Non-AC)</option>
                        <option value="4-Sharing (Non-AC)">4-Sharing (Non-AC)</option>
                    </select>
                    <div class="form-text">Choose the sharing capacity and ventilation type.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="Rent">
                        <i class="bi bi-currency-rupee me-1"></i> Monthly Rent (₹)
                    </label>
                    <input type="number" name="Rent" id="Rent" class="form-control" placeholder="e.g. 5500" min="500" max="50000" required />
                    <div class="form-text">All-inclusive monthly charges (rent, electricity, water, and WiFi).</div>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="Occupied">
                        <i class="bi bi-people me-1"></i> Currently Occupied Beds
                    </label>
                    <input type="number" name="Occupied" id="Occupied" class="form-control" value="0" min="0" max="50" required />
                    <div class="form-text">Number of beds currently occupied in this category.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1 py-2">
                        <i class="bi bi-plus-circle me-1"></i> Save Room
                    </button>
                    <a asp-controller="Adminhome" asp-action="UpdateRoom" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
